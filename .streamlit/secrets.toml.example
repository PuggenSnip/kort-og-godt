# Copy this file to  .streamlit/secrets.toml  and fill in real values.
# .streamlit/secrets.toml is gitignored — never commit it.
#
# On Streamlit Community Cloud you don't create this file; instead paste these
# same two lines into the app's  Settings -> Secrets  box.

# Shared Postgres connection string (from Supabase/Neon). If omitted, the app
# falls back to a LOCAL SQLite file (single-machine, not shared).
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Shared password all three of you type to open the app. If omitted, there is
# no login gate (fine for purely local use).
APP_PASSWORD = "choose-a-shared-password"
